# CYCLONE-X Root Environment Variables
PROJECT_NAME="CYCLONE-X"
VERSION="0.1.0"
ENVIRONMENT="development"
DEMO_MODE=True

# Backend
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
API_URL="http://127.0.0.1:8000/api"

# Frontend
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
NEXT_PUBLIC_DEMO_MODE=true

# Database (PostGIS)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_placeholder"
POSTGRES_DB="cyclone_x"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cyclone_x"

# Phase 3: Scientific Data Intelligence & Source Integrations
# Note: Zero credentials should be committed. Leave blank for safe unconfigured/demo mode.
DATA_MODE="DEMO"

# MOSDAC / ISRO Satellite Data Adapter
MOSDAC_API_URL=""
MOSDAC_API_KEY=""

# India Meteorological Department (IMD / RSMC New Delhi) Adapter
IMD_API_URL=""
IMD_API_KEY=""

# NASA GPM / IMERG Earthdata Login Credentials
NASA_GPM_URL="https://gpm1.gesdisc.eosdis.nasa.gov/data/GPM_L3"
NASA_GPM_USERNAME=""
NASA_GPM_PASSWORD=""

# Phase 7: Real Scientific Dataset Sources & Pipeline Configuration
# NOAA / NCDC IBTrACS Best Track Global Archive (North Indian Ocean Subset)
IBTRACS_SOURCE_URL="https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r00/access/csv/ibtracs.NI.list.v04r00.csv"

# India Meteorological Department (IMD / RSMC New Delhi) Best-Track & Bulletin Archive
IMD_SOURCE_URL="https://rsmcnewdelhi.imd.gov.in"

# ECMWF ERA5 Atmospheric & Oceanic Reanalysis (Copernicus Climate Data Store)
ERA5_SOURCE_URL="https://cds.climate.copernicus.eu/api/v2"
CDS_API_KEY=""
ERA5_VARIABLES="sea_surface_temperature,u_component_of_wind,v_component_of_wind,mean_sea_level_pressure"

# Geographic Exposure Sources (WorldPop, NASA SRTM, OpenStreetMap)
WORLDPOP_SOURCE_URL="https://hub.worldpop.org/geodata/summary?id=IND"
SRTM_SOURCE_URL="https://earthexplorer.usgs.gov"


